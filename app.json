{
  "expo": {
    "name": "Gradexis",
    "displayName": "Gradexis",
    "slug": "gradexis",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gradexis",
    "jsEngine": "hermes",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#93CEFF"
      },
      "edgeToEdge": true,
      "versionCode": 19,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.ruskcoder.gradexis"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#93CEFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set a profile picture."
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#93CEFF",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1de7adf2-c226-4dfd-b214-281496c82a3e"
      }
    }
  }
}
